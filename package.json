{
  "name": "jasonmorris",
  "author": "Jason Morris",
  "license": "MIT",
  "type": "module",
  "description": "jasonmorris.com",
  "main": "index.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsnmrs/jasonmorris.git"
  },
  "scripts": {
    "local": "npm run test && npm-run-all --parallel local:*",
    "local:css": "postcss \"css/**/*.css\" --config config/ --watch --dir \"_includes\"",
    "local:js": "chokidar \"js/**/*.js\" -c \"npm run js:build\"",
    "local:eleventy": "eleventy --serve --quiet",
    "build": "run-s lint clean build:* validate",
    "build:css": "postcss \"css/**/*.css\" --config config/ --no-map --dir \"_includes\"",
    "build:js": "npm run js:build",
    "build:html": "eleventy",
    "js:build": "run-s js:lint js:minify",
    "js:lint": "eslint --config config/eslint.config.js \"js/*.js\" --fix",
    "js:minify": "terser js/logger.js -c -m -o _includes/logger.js && terser js/media-utils.js -c -m -o _includes/media-utils.js && terser js/youtube-api.js -c -m -o _includes/youtube-api.js && terser js/video.js -c -m -o _includes/video.js && terser js/audio.js -c -m -o _includes/audio.js",
    "lint": "run-p lint:*",
    "lint:css": "stylelint --config config/.stylelintrc --ignore-path config/.stylelintignore \"css/**/*.css\" --fix",
    "lint:js": "eslint --config config/eslint.config.js \"js/**/*.js\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,md,css,yml}\"",
    "lint:content": "run-s lint:content:*",
    "lint:content:md": "double-check \"{posts,pages}/**/*.md\" --liquid",
    "lint:content:html": "double-check \"{posts,pages}/**/*.html\" --html --liquid",
    "lint:markdown": "remark --rc-path config/.remarkrc.cjs posts",
    "validate": "run-p validate:*",
    "validate:html": "html-validate --config config/.htmlvalidate.json _site",
    "clean": "rimraf _site _includes/*.{css,js}",
    "format": "run-s lint:prettier lint:css lint:js",
    "test": "npm run build",
    "test:a11y": "playwright test --config config/playwright.config.js"
  },
  "browserslist": ["defaults and > .5% in US"],
  "double-check": {
    "retext-quotes": true,
    "retext-contractions": true,
    "retext-simplify": false,
    "retext-spell": false
  },
  "dependencies": {
    "@11ty/eleventy-img": "7.0.0",
    "@double-great/double-check": "0.5.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@axe-core/playwright": "4.13.0",
    "@double-great/remark-lint-alt-text": "1.1.1",
    "@double-great/stylelint-a11y": "3.5.4",
    "@playwright/test": "1.63.0",
    "autoprefixer": "10.6.1",
    "chokidar-cli": "3.0.0",
    "cssnano": "9.1.2",
    "eleventy-plugin-git-commit-date": "1.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "html-validate": "11.16.1",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.28",
    "postcss-cli": "12.0.0",
    "prettier": "3.9.9",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-frontmatter-validator": "2.0.0",
    "rimraf": "6.1.3",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-plugin-defensive-css": "2.9.7",
    "stylelint-plugin-logical-css": "2.1.0",
    "terser": "5.51.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
